{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Node16",
		"declaration": false,
		"declarationMap": false,
		"strict": true,
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "node16",
		"resolveJsonModule": true,
		"paths": {
			"@types": ["./src/types.mts"],
			"*": ["./src/*"],
		},
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}